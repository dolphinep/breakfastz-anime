{
  "name": "anime-head",
  "private": true,
  "version": "0.0.0",
  "description": "Webcam that swaps only your head for an anime (VRM) head — your body, hands and gestures stay real. Runs fully in the browser.",
  "license": "MIT",
  "author": "dolphinep (breakfastz)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && node scripts/fetch-models.mjs && vite",
    "build": "node scripts/copy-wasm.mjs && node scripts/fetch-models.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@pixiv/three-vrm": "3.5.5",
    "lucide-react": "^1.70.0",
    "react": "^19",
    "react-dom": "^19",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6",
    "oxlint": "^1.92.0",
    "typescript": "~6.0",
    "vite": "^8",
    "vitest": "^5"
  }
}
